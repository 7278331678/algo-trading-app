# Copy to .env and fill in. Never commit .env.
# Rules: KEY=value, no quotes, no comments on the same line as a value.

# local = everything on this laptop, cloud = AWS
APP_MODE=local
# paper = simulated orders, live = real orders (needs LIVE_TRADING_CONFIRM too)
TRADING_MODE=paper
LIVE_TRADING_CONFIRM=
LOG_LEVEL=INFO

# Zerodha Kite Connect (developers.kite.trade, Connect plan)
# In the Kite app settings set the redirect URL to exactly the value below.
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://127.0.0.1:8100/auth/kite/callback

# Local infrastructure passwords (any characters are fine)
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=tradingadmin
MINIO_ROOT_PASSWORD=change-me

# Local LLM (Ollama runs natively on Windows)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# Email (local mode uses the MailHog inbox at http://localhost:8025)
EMAIL_FROM=trading-app@localhost
EMAIL_TO=you@example.com

# Risk defaults
CAPITAL=100000
RISK_PER_TRADE_PCT=0.5
DAILY_LOSS_CAP_PCT=2.0
MAX_TRADES_PER_DAY=5
